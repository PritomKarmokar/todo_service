PORT=8080
TIME_ZONE=Asia/Dhaka

LOG_LEVEL_API=info

HIDE_BANNER=false
HIDE_PORT=false

MASTER_DB_NAME=todo_service_db
MASTER_DB_USER=postgres
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_PASSWORD=postgres
MASTER_SSL_MODE=disable

TEST_DB_NAME=test_db

REPLICA_DB_NAME=todo_service_db
REPLICA_DB_USER=postgres
REPLICA_DB_HOST=localhost
REPLICA_DB_PORT=5432
REPLICA_DB_PASSWORD=postgres
REPLICA_SSL_MODE=disable

SET_MAX_IDLE_CONNECTIONS=10
SET_MAX_OPEN_CONNECTIONS=50# If n <= 0, then there is no limit on the number of open connections.
SET_CONNECTION_MAX_IDLE_TIME=10m# If d <= 0, connections are not closed due to a connection's idle time.
SET_CONNECTION_MAX_LIFE_TIME=1h# If d <= 0, connections are not closed due to a connection's age.
